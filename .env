##################################################################################
################ Parâmetros do ASR(Automatic Speaker Recognition) ################
##################################################################################

UTTERANCES_PATH=C:\Users\Felipe Mesquita\Downloads\utterances
SAVES_PATH=C:\Users\Felipe Mesquita\Documents\ASRsystem\saves

NUM_SPEAKERS=80
NUM_UTTERANCES=5
NUM_MFCCS=40
FRAME_SIZE=256


##################################################################################
##### Parâmetros do subsistema de pré processamento(PreprocessingSubsystem) ######
##################################################################################

UTTERANCES_SAMPLING_RATE=48000
PRE_EMPHASIS_COEF=0.97
LOW_PASS_CUTOFF=4000
TARGET_SAMPLING_RATE=8000
DELTA_DELTA_ORDER=2

# Remoção de silêncio
REMOVE_SILENCE=False                    # True para remover silêncio, False para manter
SILENCE_THRESHOLD_DB=20                 # Threshold em dB para considerar silêncio (quanto menor, mais agressivo)


##################################################################################
### Parâmetros do subsistema de ajuste de features(FeatureAdjustmentSubsystem) ###
##################################################################################

TEST_UTTERANCE_INDEX=5

# Estratégia de equalização de frames
FRAME_STRATEGY=max                      # "max" = aumenta para o maior, "min" = capa para o menor


##################################################################################
#### Parâmetros do subsistema de deep learning(DeepLearningSubsystem) ############
##################################################################################

# Arquitetura da rede
CONV1D_FILTERS=64
CONV1D_KERNEL_SIZE=4
DENSE_UNITS=256

# Regularização
L2_REGULARIZATION=0.05

# Treinamento
BATCH_SIZE=32
EPOCHS=100
LEARNING_RATE=0.001

# Callbacks
EARLY_STOPPING_PATIENCE=30
REDUCE_LR_PATIENCE=30
REDUCE_LR_FACTOR=0.2
REDUCE_LR_MIN_LR=0.000001